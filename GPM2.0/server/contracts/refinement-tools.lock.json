      "archive": {
        "url": "https://codeload.github.com/aaranyue/quarTeT/tar.gz/a44d8c87e3f4bcefaf43dc4134e88b6a21890265",
        "sha256": "51c459512df08aee96e3250c8bddf65d75f1da1a58fbf72c47edae4da9b434b0"
