      "patches": [
        {
          "id": "python311-fstring-quotes-v1",
          "file": "quartet/gapfiller.py",
          "before_sha256": "b81b5636a97db253454516c765986ded6a50fbfb95ea2513d8d9a240fe117e98",
          "after_sha256": "8f85a960c1163d0f4d373e28415eaee16f8871249987c5b8b836bdb12b4685a6",
          "old": "{len(info[\"seq\"]) if info[\"seq\"] != '' else 'join'}",
          "new": "{len(info[\"seq\"]) if info[\"seq\"] != \"\" else \"join\"}",
          "purpose": "Python 3.11 quoting compatibility only; no algorithm or parameter changes"
        },
        {
          "id": "gapfiller-empty-paf-optional-v1",
          "file": "quartet/util.py",
          "before_sha256": "5554eeb3abeaf092fb6b4aaf6c4ba7026133c3a00117682c06d8b21bf52ed914",
          "after_sha256": "1a191fe4c7570516add04f1e48c6ab4ba4f7c7997af7e04b60f045458075b819",
          "old": "def minimap(reffasta, qryfasta, prefix, suffix, minimapoption, plot, overwrite, aligner):",
          "new": "def minimap(reffasta, qryfasta, prefix, suffix, minimapoption, plot, overwrite, aligner, allow_empty=False):",
          "purpose": "GapFiller alone continues after a successful aligner with an empty PAF; nonzero aligner errors still fail. No alignment thresholds or candidate selection changes."
        },
        {
          "id": "gapfiller-empty-paf-guard-v1",
          "file": "quartet/util.py",
          "before_sha256": "1a191fe4c7570516add04f1e48c6ab4ba4f7c7997af7e04b60f045458075b819",
          "after_sha256": "09a179dd27eba0388d7e557b49a15f15a119276d33081d085c0b94fc4fb87575",
          "old": "if os.path.getsize(f'{prefix}.{suffix}.paf') == 0:",
          "new": "if os.path.getsize(f'{prefix}.{suffix}.paf') == 0 and not allow_empty:",
          "purpose": "GapFiller alone continues after a successful aligner with an empty PAF; nonzero aligner errors still fail. No alignment thresholds or candidate selection changes."
        },
        {
          "id": "gapfiller-continue-empty-input-v1",
          "file": "quartet/gapfiller.py",
          "before_sha256": "8f85a960c1163d0f4d373e28415eaee16f8871249987c5b8b836bdb12b4685a6",
          "after_sha256": "72c16b23c4a31ac8e8eece3d9dec222edde5dd4c561fb0b3ae8fa4b2c259437e",
          "old": "util.minimap(gapfillfile, flankingfastafile, prefix, f'flank_map_{gapfiller}', minimapoption, False, overwrite, aligner)",
          "new": "util.minimap(gapfillfile, flankingfastafile, prefix, f'flank_map_{gapfiller}', minimapoption, False, overwrite, aligner, allow_empty=True)",
          "purpose": "GapFiller alone continues after a successful aligner with an empty PAF; nonzero aligner errors still fail. No alignment thresholds or candidate selection changes."
        }
      ],
