#!/bin/bash
#DSUB -n jm19_formal_4d_budget
#DSUB -q x86
#DSUB -aa
#DSUB -nl agent-X86-04
#DSUB -R "cpu=8,mem=98304MB"
#DSUB -o formal_budget_%J.out
set -euo pipefail
umask 077
here=$PWD; base=$(dirname "$here"); q=$base/q0-request-ready.44e274a7/qualification; e=$base/q0-fast4d-20261125.T0MmzPVx/E
sha256sum -c --quiet kit.sha256
printf '%s  %s\n' 9fe4a884f98b500fa00c3ea1e6bfd62918a514507637c4793b0fe7b1d213703f "$q/group.py" 36b6c31cd0e5b0049b47646f96d2991081050d79d24b947c95a1aee645d6a70a "$q/fork_wheat_q0.py" 0f06edd183467d950cd99d5c11ca8ed23ff57aaeacce96a6580b7527573dac28 "$q/latest.tgz" c443b479efd5419953bf9409be372c8b3f90e12971c08874aee805da13ab8aa8 "$e/pilot_fast_group_run.py" | sha256sum -c --quiet -
set +u; source "$HOME/cgat-reads-debug/jm19-x86-readiness-20261118/environment.sh"; set -u
w=$(mktemp -d /tmp/wheat-formal-budget.XXXXXXXX); trap 'rm -rf -- "$w"' EXIT
mkdir "$w/input" "$w/frozen" "$w/current" "$w/control"; cp "$e/pilot_fast_group_run.py" "$w/control/"; tar -xzf "$q/latest.tgz" -C "$w/frozen"; tar -xzf tools.tgz -C "$w/current"
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 GPM_RUN_THREADS=8
PYTHONPATH="$w/frozen/GPM2.0/server/tools" python3 -Bu "$q/group.py" stage "$base" "$w/input"
for i in {1..120}; do [[ ! -s allocation.json ]] || break; sleep 2; done; test -s allocation.json
export _GPM_Q0_SCHEDULER_PROOF="$here/allocation.json"; _GPM_Q0_SCHEDULER_SHA256=$(sha256sum allocation.json|cut -d' ' -f1); export _GPM_Q0_SCHEDULER_SHA256
mkdir result
PYTHONPATH="$w/current/tools:$w/control" python3 -Bu measure_wheat_formal_placement_budget.py "$w/input" "$base" "$here/result"
sha256sum result/arm-1.json result/arm-8.json result/result.json
