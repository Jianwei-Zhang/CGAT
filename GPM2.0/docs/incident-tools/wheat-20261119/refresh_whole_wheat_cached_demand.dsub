#!/bin/bash
#DSUB -n jm19_q0_update_cached_only
#DSUB -q x86
#DSUB -aa
#DSUB -nl agent-X86-46
#DSUB -R "cpu=56,mem=442368MB"
#DSUB -o whole_%J.out
set -eo pipefail
umask 077
owner=$PWD;base=$(dirname "$owner");ctrl="$base/q0-request-ready.44e274a7"
sha256sum --quiet -c kit.sha256
exec 9>run.lock; flock -n 9
source "$HOME/cgat-reads-debug/jm19-x86-readiness-20261118/environment.sh"
# Forty-two million starting pairs; extra CPU slots reserve node memory, not extra mapper lanes.
export GPM_RUN_THREADS=32 PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONFAULTHANDLER=1
for i in {1..120}; do [[ ! -s allocation.json ]] || break;sleep 2;done;[[ -s allocation.json ]]
export _GPM_Q0_SCHEDULER_PROOF="$owner/allocation.json";_GPM_Q0_SCHEDULER_SHA256=$(sha256sum allocation.json|cut -d ' ' -f1);export _GPM_Q0_SCHEDULER_SHA256
code=$(mktemp -d /tmp/wheat-updated-code.XXXXXXXX); trap 'rm -rf -- "$code"' EXIT
stage="/tmp/$(basename "$owner")-$(sha256sum kit.sha256 | cut -c1-12)";tar -xzf tools.tgz -C "$code"
export PYTHONPATH="$code/tools:$owner";echo "WHOLE_READ_ONLY owner=$owner node=$(hostname) stage=$stage threads=$GPM_RUN_THREADS"; df -h /tmp | tail -1
python3 -Bu refresh_whole_wheat_cached_demand.py "$base" "$stage" "$owner" 32
sha256sum result/summary.json result/updated-questions.json.gz
# A failed/interrupted attempt keeps its sealed local PAFs; remove only this successful private scratch.
if [[ "$stage" == /tmp/q0-whole-updated.* && ! -L "$stage" && -O "$stage" && -s "$owner/result/summary.json" ]]; then rm -rf -- "$stage"; fi
