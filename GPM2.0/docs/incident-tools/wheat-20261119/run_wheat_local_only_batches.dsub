#!/bin/bash
#DSUB -n jm19_q0_15_regional
#DSUB -q x86
#DSUB -aa
#DSUB -nl agent-X86-46
#DSUB -R "cpu=32,mem=131072MB"
#DSUB -o regionals_%J.out
set -eo pipefail
umask 077
exec 9>regional.lock; flock -n 9
sha256sum --quiet -c kit.sha256
source "$HOME/cgat-reads-debug/jm19-x86-readiness-20261118/environment.sh"
b=$(dirname "$PWD"); h="$b/q0-bound-first-demand.8xpsAJ"; w=$(mktemp -d /tmp/wheat-local-maps-code.XXXXXXXX); trap 'rm -rf -- "$w"' EXIT
mkdir "$w/helpers"; printf '%s  %s\n' 9d0971e43033a2be9124a7956cfa41a9832c3c9d760f2768701e5090c5f7300d "$h/controls.sha256" | sha256sum --quiet -c -
while read -r pin f; do case "$f" in *.py) cp "$h/$f" "$w/helpers/$f";printf '%s  %s\n' "$pin" "$w/helpers/$f" |sha256sum --quiet -c -;; esac; done < "$h/controls.sha256"
tar -xzf tools.tgz -C "$w"; export PYTHONPATH="$w/tools:$w/helpers" PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1
for wait in $(seq 1 90); do if test -s allocation.json; then break; fi; sleep 5; done
test -s allocation.json
export _GPM_Q0_SCHEDULER_PROOF="$PWD/allocation.json" _GPM_Q0_SCHEDULER_SHA256=$(sha256sum allocation.json|cut -d' ' -f1)
python3 -Bu run_wheat_local_only_batches.py "$b"
sha256sum result.json
