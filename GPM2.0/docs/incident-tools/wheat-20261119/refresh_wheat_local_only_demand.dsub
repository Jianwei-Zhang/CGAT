#!/bin/bash
#DSUB -n jm19_q0_local_full_draft
#DSUB -q x86
#DSUB -aa
#DSUB -nl agent-X86-46
#DSUB -R "cpu=32,mem=327680MB"
#DSUB -o local_whole_%J.out
set -eo pipefail
umask 077
owner=$PWD; base=$(dirname "$owner"); sha256sum --quiet -c kit.sha256; exec 9>run.lock; flock -n 9
source "$HOME/cgat-reads-debug/jm19-x86-readiness-20261118/environment.sh"
export GPM_RUN_THREADS=32 PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONFAULTHANDLER=1
for i in {1..120};do [[ ! -s allocation.json ]] ||break; sleep 3; done;test -s allocation.json
export _GPM_Q0_SCHEDULER_PROOF="$owner/allocation.json" _GPM_Q0_SCHEDULER_SHA256=$(sha256sum allocation.json|cut -d' ' -f1)
code=$(mktemp -d /tmp/wheat-local-draft-code.XXXXXXXX);trap 'rm -rf -- "$code"' EXIT
stage="/tmp/$(basename "$owner")-$(sha256sum kit.sha256|cut -c1-12)";# Use the same sealed selection engine as the prior 22-group baseline, not a mixed code/evidence comparison.
printf '%s  tools.tgz\n' 19cebdc7667d912f6d3ace4a59783d3e49fbb02e668ff5f5efbb50c618c27ad2 | sha256sum --quiet -c -
tar -xzf tools.tgz -C "$code"; export PYTHONPATH="$code/tools:$owner"
python3 -Bu refresh_whole_wheat_cached_demand.py "$base" "$stage" "$owner" 32 "$(cat local-mapping-owner)"
sha256sum result/summary.json result/updated-questions.json.gz
if [[ "$stage" == /tmp/q0-whole-local-maps.* && -d "$stage" && ! -L "$stage" && -O "$stage" && -s "$owner/result/summary.json" ]]; then rm -rf -- "$stage"; fi
