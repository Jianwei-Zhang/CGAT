#!/bin/bash
#DSUB -n jm19_1A_gap_rescue_cached
#DSUB -q x86
#DSUB -aa
#DSUB -nl agent-X86-34
#DSUB -R "cpu=8,mem=81920MB"
#DSUB -o gap_rescue_%J.out
set -eo pipefail
umask 077
sha256sum --quiet -c gap-rescue-kit.sha256
source "$HOME/cgat-reads-debug/jm19-x86-readiness-20261118/environment.sh"
export PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1
base=$(dirname "$PWD")
selection="$base/q0-continuity-indexed-20261126.CgydRhOS"
admission="$base/q0-continuity-20261126.RAbGvNba"
code=$(mktemp -d /tmp/wheat-gap-rescue-code.XXXXXXXX)
tar -xzf "$selection/tools.tgz" -C "$code"
export PYTHONPATH="$PWD:$selection:$code/tools"
python3 -Bu -m unittest -v test_wheat_continuity_gap_rescue
python3 -Bu wheat_continuity_gap_rescue_readonly.py "$selection" "$admission" "$PWD"
