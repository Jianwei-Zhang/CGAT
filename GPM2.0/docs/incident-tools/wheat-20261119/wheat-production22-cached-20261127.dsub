#!/bin/bash
#DSUB -n jm19_q0_production22_cached
#DSUB -q x86
#DSUB -aa
#DSUB -nl agent-X86-34
#DSUB -R "cpu=32,mem=327680MB"
#DSUB -o production22_%J.out
set -euo pipefail
umask 077
owner=$PWD
base=$(dirname "$owner")
sha256sum --quiet -c kit.sha256
exec 9>run.lock
flock -n 9
source "$HOME/cgat-reads-debug/jm19-x86-readiness-20261118/environment.sh"
export GPM_RUN_THREADS=32 PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONFAULTHANDLER=1
for i in {1..120}; do
    [[ ! -s allocation.json ]] || break
    sleep 3
done
test -s allocation.json
export _GPM_Q0_SCHEDULER_PROOF="$owner/allocation.json"
export _GPM_Q0_SCHEDULER_SHA256=$(sha256sum allocation.json | cut -d" " -f1)
code=$(mktemp -d /tmp/wheat-production22-code.XXXXXXXX)
trap 'rm -rf -- "$code"' EXIT
stage="/tmp/$(basename "$owner")-$(sha256sum kit.sha256 | cut -c1-12)"
tar -xzf tools.tgz -C "$code"
export PYTHONPATH="$code/tools:$owner"
if [[ -f baseline-owner ]]; then
    python3 -Bu wheat_source_collision_controls.py full "$base" "$stage" "$owner"
    sha256sum result/source-control-audit.json
else
    python3 -Bu wheat_production22_cached.py "$base" "$stage" "$owner"
fi
sha256sum result/summary.json result/production22-audit.json
# Keep the isolated node-local staged inputs for bounded restart/review. Never
# remove or modify the formal workspace or any completed original evidence.
