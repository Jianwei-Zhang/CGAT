#!/bin/bash
#DSUB -n jm19_q0_compare_22
#DSUB -q x86
#DSUB -aa
#DSUB -nl agent-X86-46
#DSUB -D "43084475=SUCCEEDED"
#DSUB -R "cpu=1,mem=8192MB"
#DSUB -o compare_%J.out
set -eo pipefail
umask 077
sha256sum --quiet -c kit.sha256
exec 9>compare.lock; flock -n 9
source "$HOME/cgat-reads-debug/jm19-x86-readiness-20261118/environment.sh"
w=$(mktemp -d /tmp/wheat-path-compare.XXXXXXXX);trap 'rm -rf -- "$w"' EXIT
tar -xzf tools.tgz -C "$w"; export PYTHONPATH="$w/tools:$PWD" PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1
python3 -Bu compare_wheat_local_only_paths.py "$(cat whole-owner)" "$(cat map-owner)" "$(cat assess-owner)"
sha256sum comparison.json
