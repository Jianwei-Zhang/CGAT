#!/bin/bash
#DSUB -n jm19_3B_3D_top_chain_cross
#DSUB -q x86
#DSUB -aa
#DSUB -nl agent-X86-34
#DSUB -R "cpu=8,mem=81920MB"
#DSUB -o top_chain_cross_%J.out
set -eo pipefail
umask 077
sha256sum --quiet -c cross-kit.sha256
source "$HOME/cgat-reads-debug/jm19-x86-readiness-20261118/environment.sh"
export PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1
base=$(dirname "$PWD")
original="$base/q0-continuity-indexed-20261126.CgydRhOS"
phase1="$base/q0-top-chain-locus-20261127.CTotPSFG"
code=$(mktemp -d /tmp/wheat-cross-code.XXXXXXXX)
tar -xzf "$original/tools.tgz" -C "$code"
export PYTHONPATH="$PWD:$phase1:$original:$code/tools"
python3 -Bu -m unittest -v test_wheat_top_chain_locus
python3 -Bu wheat_top_chain_cross_readonly.py "$base" "$base/q0-continuity-20261126.RAbGvNba" "$base/q0-local-chain-20261126.nyLKgP1a" "$PWD" --workers 4 --one-a-owner "$base/q0-top-chain-canonical-20261127.AVZGRNxP"
