#!/bin/bash
#DSUB -n jm19_inversion_frozen_warning_audit
#DSUB -q x86
#DSUB -aa
#DSUB -nl agent-X86-34
#DSUB -R "cpu=1,mem=10240MB"
#DSUB -o inversion_audit_%J.out
set -eo pipefail
umask 077
sha256sum --quiet -c audit-kit.sha256
source "$HOME/cgat-reads-debug/jm19-x86-readiness-20261118/environment.sh"
export PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1
base=$(dirname "$PWD")
original="$base/q0-continuity-indexed-20261126.CgydRhOS"
phase1="$base/q0-top-chain-locus-20261127.CTotPSFG"
cross="$base/q0-top-chain-cross-20261127.XLaIRQyk"
code=$(mktemp -d /tmp/wheat-inversion-audit-code.XXXXXXXX)
tar -xzf "$original/tools.tgz" -C "$code"
export PYTHONPATH="$PWD:$cross:$phase1:$original:$code/tools"
python3 -Bu wheat_inversion_result_audit.py "$base" "$PWD"
